# 図面ファイル（実案件のデータはリポジトリに入れない。置き場は ~/sekozu-data/）
# 大文字の拡張子も除外するため、大文字小文字を問わないパターンにしている
*.[pP][dD][fF]
*.[jJ][wW][wW]
*.[jJ][wW][cC]
*.[dD][xX][fF]
*.[dD][wW][gG]
*.[xX][dD][wW]
*.[xX][bB][dD]

# 名前を伏せて加工したデモ用データだけは例外
!demo-data/**

# 環境変数・APIキー
.env
.env.*
!.env.example

# 依存パッケージ
node_modules/

# Next.js / TypeScript の生成物
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# ログ
npm-debug.log*

# OS / エディタ
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# prototype の生成物（実図面からの抽出結果）
prototype/model.json

# Python 仮想環境
.venv/

# 公開の確認が取れていない物件のデータ（手元の画面でだけ表示する）
demo-data-private/
